name: Build MangaRu APK

on:
  workflow_dispatch:
  push:
    paths:
      - "MangaRu-Android-0.2-fixed.zip"
      - ".github/workflows/build.yml"

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Download project
        uses: actions/checkout@v4

      - name: Extract MangaRu project
        run: |
          mkdir project
          unzip -q MangaRu-Android-0.2-fixed.zip -d project

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.10"

      - name: Build APK
        working-directory: project/MangaRuAndroid
        run: gradle assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: MangaRu-debug
          path: project/MangaRuAndroid/app/build/outputs/apk/debug/app-debug.apk
